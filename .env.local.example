# Anthropic Claude API key (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for Brain dump's AI to-do extraction.
# Defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Postgres connection string for the admin backend (users list + meditation
# content). Create one via the Neon marketplace integration on Vercel's
# Storage tab (Vercel no longer offers first-party "Postgres" directly),
# or sign up at neon.com and copy its connection string here.
DATABASE_URL=

# Vercel Blob read/write token, used when admin uploads a meditation
# recording file. Create a Blob store on Vercel (Storage tab → Create
# Database → Blob) and copy its token here.
BLOB_READ_WRITE_TOKEN=

# Password for /admin — pick your own strong value.
ADMIN_PASSWORD=

# Random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Random secret used to sign the regular user's login session cookie.
# Must be different from ADMIN_SESSION_SECRET. Generate with: openssl rand -base64 32
USER_SESSION_SECRET=
